<script>
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ── Scroll progress bar ── */
window.addEventListener('scroll', () => {
  const el = document.getElementById('progress');
  const pct = window.scrollY / (document.body.scrollHeight - window.innerHeight) * 100;
  el.style.width = Math.min(pct, 100) + '%';
});

/* ── Particle network background ── */
(function(){
  if (reduceMotion) return;
  const canvas = document.getElementById('bg-canvas');
  const ctx = canvas.getContext('2d');
  let w, h, particles, dpr;
  const mouse = { x: null, y: null };

  function resize(){
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    w = canvas.width = innerWidth * dpr;
    h = canvas.height = innerHeight * dpr;
    canvas.style.width = innerWidth + 'px';
    canvas.style.height = innerHeight + 'px';
    const count = Math.min(90, Math.floor(innerWidth * innerHeight / 16000));
    particles = Array.from({length: count}, () => ({
      x: Math.random()*w, y: Math.random()*h,
      vx: (Math.random()-.5)*.35*dpr, vy: (Math.random()-.5)*.35*dpr,
      r: (Math.random()*1.6+.6)*dpr
    }));
  }
  window.addEventListener('mousemove', e => { mouse.x = e.clientX*dpr; mouse.y = e.clientY*dpr; });
  window.addEventListener('mouseout', () => { mouse.x = mouse.y = null; });

  const LINK = 130;
  function draw(){
    ctx.clearRect(0,0,w,h);
    for (const p of particles){
      p.x += p.vx; p.y += p.vy;
      if (p.x<0||p.x>w) p.vx*=-1;
      if (p.y<0||p.y>h) p.vy*=-1;
      ctx.beginPath();
      ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
      ctx.fillStyle = 'rgba(29,184,122,.7)';
      ctx.fill();
    }
    const link = LINK*dpr;
    for (let i=0;i<particles.length;i++){
      for (let j=i+1;j<particles.length;j++){
        const a=particles[i], b=particles[j];
        const dx=a.x-b.x, dy=a.y-b.y, d=Math.hypot(dx,dy);
        if (d<link){
          ctx.beginPath();
          ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y);
          ctx.strokeStyle = 'rgba(29,184,122,'+(.16*(1-d/link))+')';
          ctx.lineWidth = dpr;
          ctx.stroke();
        }
      }
      if (mouse.x!=null){
        const a=particles[i];
        const dx=a.x-mouse.x, dy=a.y-mouse.y, d=Math.hypot(dx,dy);
        if (d<link*1.4){
          ctx.beginPath();
          ctx.moveTo(a.x,a.y); ctx.lineTo(mouse.x,mouse.y);
          ctx.strokeStyle = 'rgba(110,231,183,'+(.25*(1-d/(link*1.4)))+')';
          ctx.lineWidth = dpr;
          ctx.stroke();
        }
      }
    }
    requestAnimationFrame(draw);
  }
  resize();
  window.addEventListener('resize', resize);
  draw();
})();

/* ── Animated count-up stats ── */
function animateCount(el){
  const target = +el.dataset.target;
  const suffix = el.dataset.suffix || '';
  const prefix = el.dataset.prefix || '';
  const sep = el.hasAttribute('data-sep');
  const dur = 1400; const start = performance.now();
  function fmt(n){
    n = Math.round(n);
    return prefix + (sep ? n.toLocaleString('it-IT') : n) + suffix;
  }
  function step(now){
    const t = Math.min((now-start)/dur, 1);
    const eased = 1 - Math.pow(1-t, 3);
    el.textContent = fmt(target*eased);
    if (t<1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

/* ── Generic reveal + targeted triggers ── */
const revealEls = document.querySelectorAll('.kpi-card, .tech-card, .sec-item, .pipeline-step');
revealEls.forEach(el => {
  el.style.opacity = '0';
  el.style.transform = 'translateY(20px)';
  el.style.transition = 'opacity .5s ease, transform .5s ease';
});
const revealObs = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting){
      e.target.style.opacity = '1';
      e.target.style.transform = 'translateY(0)';
      revealObs.unobserve(e.target);
    }
  });
}, { threshold: 0.1 });
revealEls.forEach(el => revealObs.observe(el));

/* stats count-up when hero stats enter view */
const statsObs = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting){
      e.target.querySelectorAll('.stat-val').forEach(animateCount);
      statsObs.unobserve(e.target);
    }
  });
}, { threshold: 0.4 });
const statsEl = document.querySelector('.stats');
if (statsEl) statsObs.observe(statsEl);

/* ── Pipeline sequential light-up + data flow ── */
const pipeline = document.querySelector('.pipeline');
const pipeSteps = document.querySelectorAll('.pipeline-step');
const pipeObs = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting){
      pipeSteps.forEach((s, i) => setTimeout(() => s.classList.add('lit'), 250 + i*350));
      if (!reduceMotion) pipeline.classList.add('run');
      pipeObs.unobserve(e.target);
    }
  });
}, { threshold: 0.3 });
if (pipeline) pipeObs.observe(pipeline);
</script>
