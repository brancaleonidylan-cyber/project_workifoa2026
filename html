<title>Green Control BI — Dylan Brancaleoni | Project Work IFOA 2026</title>
<meta name="description" content="Sistema di Business Intelligence per Green Control: pipeline Excel → Python ETL → MySQL → Power BI → Streamlit. Project Work IFOA 2026 di Dylan Brancaleoni.">
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0a0f0d;
  --bg2:#111814;
  --bg3:#1a2420;
  --green:#1DB87A;
  --green-d:#0a5c36;
  --green-l:#6EE7B7;
  --amber:#F59E0B;
  --red:#EF4444;
  --text:#F0F0EE;
  --muted:#8BA89E;
  --border:#1f3028;
  --mono:'JetBrains Mono',monospace;
  --sans:'Inter',sans-serif;
}
html{scroll-behavior:smooth}
body{font-family:var(--sans);background:var(--bg);color:var(--text);line-height:1.6;overflow-x:hidden}

/* ── ANIMATED BACKGROUND LAYERS ── */
#bg-canvas{position:fixed;inset:0;z-index:-2;display:block}
#bg-aurora{position:fixed;inset:0;z-index:-3;overflow:hidden;pointer-events:none}
.blob{
  position:absolute;border-radius:50%;filter:blur(80px);opacity:.5;
  mix-blend-mode:screen;will-change:transform;
}
.blob.b1{width:46vw;height:46vw;background:radial-gradient(circle,rgba(29,184,122,.55),transparent 70%);top:-10%;left:-8%;animation:float1 22s ease-in-out infinite}
.blob.b2{width:38vw;height:38vw;background:radial-gradient(circle,rgba(110,231,183,.4),transparent 70%);bottom:-12%;right:-6%;animation:float2 28s ease-in-out infinite}
.blob.b3{width:30vw;height:30vw;background:radial-gradient(circle,rgba(16,120,80,.5),transparent 70%);top:40%;left:55%;animation:float3 25s ease-in-out infinite}
@keyframes float1{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(8vw,12vh) scale(1.15)}}
@keyframes float2{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(-10vw,-8vh) scale(1.2)}}
@keyframes float3{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(-6vw,10vh) scale(.85)}}

/* ── SCROLL PROGRESS ── */
#progress{position:fixed;top:0;left:0;height:3px;background:linear-gradient(90deg,var(--green-d),var(--green),var(--green-l));z-index:999;transition:width .1s;box-shadow:0 0 12px rgba(29,184,122,.6)}

/* ── NAV ── */
nav{
  position:fixed;top:0;left:0;right:0;z-index:100;
  display:flex;align-items:center;justify-content:space-between;
  padding:0 48px;height:60px;
  background:rgba(10,15,13,.72);
  backdrop-filter:blur(12px);
  border-bottom:1px solid var(--border);
}
.nav-logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:16px}
.nav-dot{width:28px;height:28px;background:var(--green);border-radius:7px;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:11px;font-weight:700;color:#000;box-shadow:0 0 0 0 rgba(29,184,122,.5);animation:pulse 3s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(29,184,122,.5)}70%{box-shadow:0 0 0 10px rgba(29,184,122,0)}100%{box-shadow:0 0 0 0 rgba(29,184,122,0)}}
.nav-links{display:flex;gap:28px}
.nav-links a{color:var(--muted);text-decoration:none;font-size:13px;font-weight:500;transition:color .2s}
.nav-links a:hover{color:var(--green)}
.nav-cta{
  padding:7px 18px;border-radius:8px;
  background:var(--green);color:#000;
  font-size:13px;font-weight:700;text-decoration:none;
  transition:opacity .2s,transform .2s;
}
.nav-cta:hover{opacity:.85;transform:translateY(-1px)}

/* ── HERO ── */
.hero{
  min-height:100vh;display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  padding:100px 24px 80px;text-align:center;
  position:relative;overflow:hidden;
}
.hero::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse 80% 60% at 50% 40%,rgba(29,184,122,.10) 0%,transparent 70%);
  pointer-events:none;
}
.hero-badge{
  display:inline-flex;align-items:center;gap:8px;
  padding:5px 14px;border-radius:20px;
  border:1px solid rgba(29,184,122,.3);
  background:rgba(29,184,122,.08);
  font-size:12px;font-family:var(--mono);color:var(--green);
  margin-bottom:28px;
  opacity:0;animation:riseIn .8s .1s forwards;
}
.badge-dot{width:6px;height:6px;background:var(--green);border-radius:50%;animation:blink 2s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
.hero h1{
  font-size:clamp(2.4rem,6vw,4.2rem);font-weight:800;
  line-height:1.1;letter-spacing:-.03em;
  margin-bottom:20px;
  opacity:0;animation:riseIn .9s .25s forwards;
}
.hero h1 span{
  background:linear-gradient(120deg,var(--green-l),var(--green));
  -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
  filter:drop-shadow(0 0 18px rgba(29,184,122,.35));
}
.hero p{
  max-width:600px;font-size:1.05rem;color:var(--muted);
  line-height:1.7;margin-bottom:40px;
  opacity:0;animation:riseIn .9s .4s forwards;
}
.hero-btns{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;opacity:0;animation:riseIn .9s .55s forwards}
@keyframes riseIn{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
.btn-primary{
  padding:13px 28px;border-radius:10px;
  background:var(--green);color:#000;
  font-weight:700;font-size:14px;text-decoration:none;
  transition:transform .2s,box-shadow .2s;
}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(29,184,122,.45)}
.btn-secondary{
  padding:13px 28px;border-radius:10px;
  border:1px solid var(--border);color:var(--text);
  font-weight:600;font-size:14px;text-decoration:none;
  background:rgba(255,255,255,.04);
  transition:border-color .2s,background .2s;
}
.btn-secondary:hover{border-color:var(--green);background:rgba(29,184,122,.06)}

/* ── STATS BAR ── */
.stats{
  display:flex;justify-content:center;gap:0;
  border:1px solid var(--border);border-radius:14px;
  background:rgba(17,24,20,.7);backdrop-filter:blur(6px);overflow:hidden;
  max-width:760px;margin:56px auto 0;
  opacity:0;animation:riseIn .9s .7s forwards;
}
.stat{
  flex:1;padding:20px 16px;text-align:center;
  border-right:1px solid var(--border);
}
.stat:last-child{border-right:none}
.stat-val{font-size:1.8rem;font-weight:800;color:var(--green);font-family:var(--mono);line-height:1}
.stat-lab{font-size:11px;color:var(--muted);margin-top:5px;text-transform:uppercase;letter-spacing:.6px}

/* ── SECTION ── */
section{padding:96px 24px;position:relative}
.section-inner{max-width:1100px;margin:0 auto}
.section-label{
  font-size:11px;font-family:var(--mono);color:var(--green);
  letter-spacing:1.5px;text-transform:uppercase;margin-bottom:12px;
}
.section-title{font-size:clamp(1.8rem,3.5vw,2.6rem);font-weight:800;letter-spacing:-.02em;margin-bottom:16px}
.section-sub{color:var(--muted);font-size:1rem;max-width:580px;line-height:1.7;margin-bottom:52px}

/* ── PIPELINE ── */
.pipeline{display:flex;align-items:flex-start;gap:0;overflow-x:auto;padding-bottom:8px}
.pipeline-step{
  flex:1;min-width:160px;
  display:flex;flex-direction:column;align-items:center;
  position:relative;
}
.pipeline-step:not(:last-child)::after{
  content:'';position:absolute;right:-6px;top:27px;width:36px;height:2px;
  background:linear-gradient(90deg,var(--border),var(--border));
  overflow:hidden;
}
/* animated data flow dot riding the connector */
.pipeline-step:not(:last-child)::before{
  content:'';position:absolute;right:-6px;top:24px;z-index:2;
  width:8px;height:8px;border-radius:50%;
  background:var(--green);box-shadow:0 0 10px var(--green);
  opacity:0;
}
.pipeline.run .pipeline-step:not(:last-child)::before{
  animation:flowDot 2.4s linear infinite;
}
.pipeline.run .pipeline-step:nth-child(1)::before{animation-delay:0s}
.pipeline.run .pipeline-step:nth-child(2)::before{animation-delay:.6s}
.pipeline.run .pipeline-step:nth-child(3)::before{animation-delay:1.2s}
.pipeline.run .pipeline-step:nth-child(4)::before{animation-delay:1.8s}
@keyframes flowDot{0%{transform:translateX(0);opacity:0}10%{opacity:1}90%{opacity:1}100%{transform:translateX(36px);opacity:0}}
.p-icon{
  width:56px;height:56px;border-radius:14px;
  display:flex;align-items:center;justify-content:center;
  font-size:22px;margin-bottom:14px;
  border:1px solid;position:relative;z-index:3;
  transition:transform .4s ease,box-shadow .4s ease;
}
.pipeline-step.lit .p-icon{transform:scale(1.12);box-shadow:0 0 28px rgba(29,184,122,.45)}
.p-name{font-size:12px;font-weight:700;margin-bottom:4px;text-align:center}
.p-tech{font-size:10px;font-family:var(--mono);color:var(--muted);text-align:center;line-height:1.5}

/* ── KPI GRID ── */
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}
.kpi-card{
  border-radius:12px;padding:20px;border:1px solid;
  transition:transform .2s,box-shadow .2s;backdrop-filter:blur(4px);
}
.kpi-card:hover{transform:translateY(-4px);box-shadow:0 12px 32px rgba(0,0,0,.35)}
.kpi-icon{font-size:22px;margin-bottom:10px}
.kpi-name{font-size:13px;font-weight:700;margin-bottom:4px}
.kpi-desc{font-size:11px;color:var(--muted);line-height:1.5}
.kpi-val{
  font-size:1.4rem;font-weight:800;font-family:var(--mono);
  margin-top:10px;color:var(--green);
}

/* ── TECH STACK ── */
.tech-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}
.tech-card{
  border-radius:10px;padding:16px 18px;
  background:rgba(17,24,20,.7);border:1px solid var(--border);
  display:flex;align-items:center;gap:12px;backdrop-filter:blur(4px);
  transition:border-color .2s,transform .2s;
}
.tech-card:hover{border-color:var(--green);transform:translateY(-3px)}
.tech-logo{font-size:24px;flex-shrink:0}
.tech-name{font-size:13px;font-weight:600}
.tech-role{font-size:11px;color:var(--muted)}

/* ── SECURITY ── */
.sec-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px}
.sec-item{
  display:flex;align-items:flex-start;gap:12px;
  padding:16px;border-radius:10px;
  background:rgba(17,24,20,.7);border:1px solid var(--border);backdrop-filter:blur(4px);
  transition:border-color .2s,transform .2s;
}
.sec-item:hover{border-color:var(--green);transform:translateY(-3px)}
.sec-ic{font-size:20px;flex-shrink:0;margin-top:2px}
.sec-t{font-size:13px;font-weight:600;margin-bottom:3px}
.sec-d{font-size:11px;color:var(--muted);line-height:1.5}

/* ── FOOTER ── */
footer{
  border-top:1px solid var(--border);
  padding:40px 24px;text-align:center;
  color:var(--muted);font-size:12px;position:relative;
}
footer a{color:var(--green);text-decoration:none}
.footer-inner{max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px}

/* ── DIVIDER ── */
.divider{height:1px;background:var(--border);margin:0 auto;max-width:1100px}

/* sections that sit above background get translucent tint */
.tinted{background:rgba(17,24,20,.55);backdrop-filter:blur(6px)}

/* ── RESPONSIVE ── */
@media(max-width:768px){
  nav{padding:0 20px}
  .nav-links{display:none}
  .stats{flex-direction:column;border-radius:12px}
  .stat{border-right:none;border-bottom:1px solid var(--border)}
  .stat:last-child{border-bottom:none}
  .pipeline{flex-direction:column;gap:20px}
  .pipeline-step:not(:last-child)::after,.pipeline-step:not(:last-child)::before{display:none}
  .footer-inner{flex-direction:column;text-align:center}
}

/* ── ACCESSIBILITY: reduce motion ── */
@media(prefers-reduced-motion:reduce){
  *{animation:none!important;transition:none!important}
  .hero-badge,.hero h1,.hero p,.hero-btns,.stats{opacity:1!important}
  #bg-canvas,#bg-aurora{display:none}
}
</style>
</head>
